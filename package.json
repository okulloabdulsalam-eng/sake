{
  "name": "kiuma-app",
  "version": "1.0.0",
  "description": "KIUMA - Kampala International University Muslim Association",
  "main": "api-config.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node server.js",
    "build:www": "node build-www.js",
    "cap:sync": "node build-www.js && npx cap sync",
    "cap:sync:android": "node build-www.js && npx cap sync android",
    "cap:sync:ios": "node build-www.js && npx cap sync ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "build:android": "node build-www.js && npx cap sync android && npx cap open android",
    "build:ios": "node build-www.js && npx cap sync ios && npx cap open ios"
  },
  "keywords": [
    "kiuma",
    "islamic",
    "education"
  ],
  "author": "KIUMA",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/browser": "^8.0.1",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5"
  }
}
