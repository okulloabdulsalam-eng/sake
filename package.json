{
  "name": "kiuma-app",
  "version": "1.0.0",
  "description": "KIUMA - Kampala International University Muslim Association",
  "main": "api-config.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node server.js",
    "demo": "npx serve . -p 5000",
    "build:www": "node build-www.js",
    "cap:sync": "node build-www.js && npx cap sync",
    "cap:sync:android": "node build-www.js && npx cap sync android",
    "cap:sync:ios": "node build-www.js && npx cap sync ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "build:android": "node build-www.js && npx cap sync android && npx cap open android",
    "build:ios": "node build-www.js && npx cap sync ios && npx cap open ios"
  },
  "keywords": [
    "kiuma",
    "islamic",
    "education"
  ],
  "author": "KIUMA",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/browser": "^8.0.1",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/geolocation": "^8.1.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "firebase-admin": "^13.5.0",
    "kiuma-reminders": "file:plugins/kiuma-reminders",
    "sqlite3": "^5.1.7"
  }
}
