{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "**/*.bat",
      "**/*.cmd",
      "**/*.sh",
      "**/*.ps1",
      "**/*.exe",
      "**/*.dll",
      "**/*.msi",
      "cloudflare/**"
    ]
  }
}
