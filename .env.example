PORT=3000
ADMIN_API_KEY=change_me

# Preferred: absolute path to Firebase service account json file.
# Example (Windows): C:\Users\Abu\keys\firebase-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# Optional fallback: paste full service account JSON as one line.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_SERVICE_ACCOUNT_JSON=
